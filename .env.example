# Server port (3000 in local dev, 8022 in Docker)
PORT=8022

# Persistent SQLite database directory (/data inside Docker)
DATA_DIR=./data

# App login credentials (required for production; if unset in dev, a first-run setup form is shown)
APP_USERNAME=admin
APP_PASSWORD=

# Secret key for AES-256-GCM encryption of saved SSH passwords & private keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret key for signing JWT session tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Set to 1 (or number of proxy hops) when running behind Caddy, Nginx, or Traefik
TRUST_PROXY=1

# Optional: Gemini API / App URL (AI Studio runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
