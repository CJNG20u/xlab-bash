# --- Login (see README: "Login & Security") ---
# Create the admin account here, or leave APP_PASSWORD empty and use the first-run screen.
# APP_USERNAME=admin
# APP_PASSWORD=choose-a-long-password

# --- Secrets (optional) ---
# Leave empty and xlab-bash generates both once and keeps them in ./data/secrets.json.
# If you set ENCRYPTION_KEY, keep it forever: changing it makes saved host passwords/keys unreadable.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=
# JWT_SECRET=

# Minutes a shell keeps running after your phone/browser disconnects (0 = end immediately)
# SESSION_LINGER_MINUTES=15

# Number of reverse proxies in front of xlab-bash (Caddy, Cloudflare Tunnel) so
# login rate limiting sees real client IPs and HTTPS is detected. Use 0 for direct LAN access.
TRUST_PROXY=1

# Only if your proxy rewrites the Host header and the terminal won't connect (403 on /ws/ssh).
# Comma-separated hostnames, e.g. ssh.example.com
# ALLOWED_ORIGINS=
